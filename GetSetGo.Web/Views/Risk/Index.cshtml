@model RiskProfile
@{ViewData["Title"]="Risk setup";}
<div class="page-head"><div><div class="eyebrow">STEP 1</div><h1>Risk setup</h1><p>These rules decide which signals you receive and how quantity is calculated.</p></div></div>
<div class="form-layout"><form method="post" class="card form-card"><div asp-validation-summary="ModelOnly" class="validation"></div>
    <div class="field-grid"><div><label asp-for="Capital">Trading capital (₹)</label><input asp-for="Capital" type="number" step="1000" /></div><div><label asp-for="TradingStyle">Trading style</label><select asp-for="TradingStyle" asp-items="Html.GetEnumSelectList<TradingStyle>()"></select></div></div>
    <div class="field-grid"><div><label asp-for="RiskPerTradePercent">Risk per trade (%)</label><input asp-for="RiskPerTradePercent" type="number" step="0.1" /></div><div><label asp-for="MaxTotalRiskPercent">Maximum total risk (%)</label><input asp-for="MaxTotalRiskPercent" type="number" step="0.1" /></div></div>
    <label asp-for="MinimumRewardRiskRatio">Minimum reward-to-risk ratio</label><input asp-for="MinimumRewardRiskRatio" type="range" min="1" max="5" step="0.5" /><div class="range-value"><span>1:1</span><strong><output id="ratioOutput">@Model.MinimumRewardRiskRatio:1</output></strong><span>5:1</span></div>
    <div asp-validation-summary="All" class="validation"></div><button class="btn primary" type="submit">Save risk rules</button>
</form><aside class="card info-card"><h3>Live calculation</h3><p>Allowed loss per trade</p><strong id="riskAmount">₹0</strong><p>Maximum combined open risk</p><strong id="maxRiskAmount">₹0</strong><hr/><small>Position size = allowed loss ÷ distance between entry and stop-loss.</small></aside></div>
