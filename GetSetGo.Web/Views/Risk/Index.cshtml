@model RiskSetupViewModel
@{ ViewData["Title"] = "Risk setup"; }
<div class="page-head"><div><div class="eyebrow">STEP 1</div><h1>Risk setup</h1><p>Allocate one trading account across styles. Every SET order checks its style budget and the combined account limit.</p></div></div>
<form method="post" class="risk-setup" data-risk-setup>
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <section class="account-card card"><div><span class="eyebrow">COMBINED ACCOUNT LIMIT</span><h2>How much capital can all styles use?</h2><p>This is the maximum total value reserved by active SET and executed orders.</p></div><div class="account-input"><label asp-for="TotalCapital">Account capital (&#8377;)</label><input asp-for="TotalCapital" type="number" min="1000" step="1000" data-account-capital /></div></section>
    <section class="allocation-bar card"><div><span>Allocated</span><strong data-allocated>₹0</strong></div><div><span>Available to allocate</span><strong data-remaining>₹0</strong></div><div class="allocation-state" data-allocation-state aria-live="polite"></div></section>
    <section class="risk-profile-grid">
    @for (var i = 0; i < Model.Profiles.Count; i++)
    {
        <article class="risk-style-card card" data-style-card>
            <header><div><span class="style-index">0@(i + 1)</span><h2>@Model.Profiles[i].TradingStyle</h2></div><span class="style-state" data-style-state>Disabled</span></header>
            <input asp-for="Profiles[i].TradingStyle" type="hidden" />
            <label asp-for="Profiles[i].Capital">Capital allocation (&#8377;)</label><input asp-for="Profiles[i].Capital" type="number" min="0" step="1000" data-style-capital /><small>Set 0 to keep this style disabled.</small>
            <div class="style-budget"><span>Maximum loss per trade</span><strong data-style-risk>₹0</strong><small>Allocation × risk per trade</small></div>
            <div class="field-grid"><div><label asp-for="Profiles[i].RiskPerTradePercent">Risk per trade (%)</label><input asp-for="Profiles[i].RiskPerTradePercent" type="number" min="0.1" max="5" step="0.1" data-risk-per-trade /></div><div><label asp-for="Profiles[i].MaxTotalRiskPercent">Maximum style risk (%)</label><input asp-for="Profiles[i].MaxTotalRiskPercent" type="number" min="0.1" max="5" step="0.1" data-max-risk /></div></div>
            <label asp-for="Profiles[i].MinimumRewardRiskRatio">Minimum reward-to-risk ratio</label><select asp-for="Profiles[i].MinimumRewardRiskRatio"><option value="1">1 : 1</option><option value="2">2 : 1</option><option value="3">3 : 1</option><option value="4">4 : 1</option><option value="5">5 : 1</option></select>
            <p class="style-error" data-style-error aria-live="polite"></p>
        </article>
    }
    </section>
    <div class="risk-save"><p data-form-error aria-live="polite"></p><button class="btn primary" type="submit" data-save-risk>Save capital allocations</button></div>
</form>
@section Scripts { <script src="~/js/risk-setup.js" asp-append-version="true"></script> }
