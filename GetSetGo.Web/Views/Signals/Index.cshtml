@model IReadOnlyList<ResearchSignal>
@{ViewData["Title"]="GET signals";}
<div class="page-head"><div><div class="eyebrow">STEP 2 · GET</div><h1>Research selected for you</h1><p>Only active EOD signals matching your style and reward-risk rules appear here.</p></div><a class="btn secondary" asp-controller="Risk" asp-action="Index">Edit risk setup</a></div>
@if(Model.Count==0){<div class="empty card"><h2>No matching signals</h2><p>There are no active ideas matching your current rules. Check again after the next EOD research cycle.</p></div>}
<div class="signal-grid">@foreach(var s in Model){<article class="card signal-card"><div class="signal-top"><span class="badge @s.Side.ToString().ToLower()">@s.Side</span><span class="muted">@s.TradingStyle</span></div><h2>@s.Symbol</h2><div class="prices"><div><span>Entry</span><b>₹@s.EntryPrice</b></div><div><span>Stop</span><b>₹@s.StopLoss</b></div><div><span>Target</span><b>₹@s.TargetPrice</b></div></div><div class="ratio">Reward / risk <strong>@s.RewardRiskRatio : 1</strong></div><div class="news"><b>AI brief</b><p>@s.AiNewsSummary</p></div><small>Valid until @s.ValidUntilUtc.ToLocalTime().ToString("dd MMM, hh:mm tt")</small><div class="signal-actions"><button type="button" class="btn secondary show-chart" data-symbol="@s.Symbol" data-entry="@s.EntryPrice" data-stop="@s.StopLoss" data-target="@s.TargetPrice">View demo chart</button><form asp-action="Set" method="post" class="api-action" data-api="/api/v1/signals/@s.Id/set" data-redirect="/Orders" data-confirm="SET this signal using your saved risk rules?"><input type="hidden" name="id" value="@s.Id"/><button class="btn primary" type="submit">SET this order →</button></form></div></article>}</div>
<dialog id="chartDialog" class="chart-dialog"><div class="chart-head"><div><div class="eyebrow">DEMO OHLC · 1 DAY</div><h2 id="chartTitle">Price chart</h2></div><button type="button" class="chart-close" aria-label="Close">×</button></div><div class="chart-legend"><span><i class="entry-dot"></i>Entry</span><span><i class="stop-dot"></i>Stop-loss</span><span><i class="target-dot"></i>Target</span><b>Sample data—not live market prices</b></div><div id="priceChart"></div><div id="chartError" class="validation"></div></dialog>
