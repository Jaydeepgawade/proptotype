@inject GetSetGo.Web.Data.IAppRepository Repository
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var activeNav = ViewData["ActiveNav"]?.ToString() ?? (currentController == "Orders" ? currentAction : currentController);
    var notificationUserId = User.Identity?.IsAuthenticated == true && User.IsInRole("Client") ? int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value) : 0;
    var notifications = notificationUserId > 0 ? await Repository.GetNotificationsAsync(notificationUserId) : Array.Empty<GetSetGo.Web.Models.AppNotification>();
}
<!DOCTYPE html>
<html lang="en">
<head><script src="~/js/theme.js" asp-append-version="true"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - GET·SET·GO</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chart.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/records.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" /></head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Dashboard" asp-action="Index"><span>GET</span>&middot;SET&middot;GO</a>
        @if(User.Identity?.IsAuthenticated==true)
        {
            <button class="nav-toggle" aria-label="Toggle navigation">&#9776;</button>
            <nav>
                @if(User.IsInRole("Client"))
                {
                    <a asp-controller="Tutorial" asp-action="Index" class="@(activeNav == "Tutorial" ? "active" : null)" aria-current="@(activeNav == "Tutorial" ? "page" : null)">Tutorial</a>
                    <a asp-controller="Risk" asp-action="Index" class="@(activeNav == "Risk" ? "active" : null)" aria-current="@(activeNav == "Risk" ? "page" : null)">Risk</a>
                    <a asp-controller="Signals" asp-action="Index" class="@(activeNav == "Signals" ? "active" : null)" aria-current="@(activeNav == "Signals" ? "page" : null)">GET</a>
                    <a asp-controller="Orders" asp-action="Set" class="@(activeNav == "Set" ? "active" : null)" aria-current="@(activeNav == "Set" ? "page" : null)">SET</a>
                    <a asp-controller="Orders" asp-action="Tracker" class="@(activeNav == "Tracker" ? "active" : null)" aria-current="@(activeNav == "Tracker" ? "page" : null)">Go\Tracker</a>
                    <a asp-controller="Orders" asp-action="History" class="@(activeNav == "History" ? "active" : null)" aria-current="@(activeNav == "History" ? "page" : null)">History</a>
                }
                else { <a asp-controller="ResearchAdmin" asp-action="Index" class="@(activeNav == "ResearchAdmin" ? "active" : null)" aria-current="@(activeNav == "ResearchAdmin" ? "page" : null)">Research desk</a> }
            </nav>
            <div class="user-menu"><button type="button" id="themeToggle" class="theme-toggle" aria-pressed="false"><span class="theme-toggle-track"><span class="theme-toggle-thumb"></span></span><span class="theme-toggle-text">Dark mode</span></button><select id="languageSelector" aria-label="Language"><option value="en">English</option><option value="mr">&#2350;&#2352;&#2366;&#2336;&#2368;</option><option value="hi">&#2361;&#2367;&#2306;&#2342;&#2368;</option><option value="ko">한국어</option></select>@if(User.IsInRole("Client")){<details class="notification-panel"><summary>&#128276;@if(notifications.Any(x=>!x.IsRead)){<i>@notifications.Count(x=>!x.IsRead)</i>}</summary><div><b>Notifications</b>@if(notifications.Count==0){<p>No notifications yet.</p>}else{foreach(var note in notifications){<p class="@(note.IsRead?"":"unread")">@note.Message</p>}<form asp-controller="Notifications" asp-action="MarkAllRead" method="post"><button class="link-button">Mark all read</button></form>}</div></details>}else{<span>@User.Identity.Name</span>}<form asp-controller="Account" asp-action="Logout" method="post"><button class="link-button">Logout</button></form></div>
        }
    </header>
    <main class="shell">
        @if(TempData["Success"] is string success){<div class="alert success">@success</div>}
        @if(TempData["Error"] is string error){<div class="alert error">@error</div>}
        @RenderBody()
    </main>
    <button type="button" class="back-to-top" data-back-to-top aria-label="Back to top" title="Back to top">↑</button>
    <script src="~/lib/jquery/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/lightweight-charts/lightweight-charts.standalone.production.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script><script src="~/js/translations.js" asp-append-version="true"></script><script src="~/js/translations-ko.js" asp-append-version="true"></script><script src="~/js/language.js" asp-append-version="true"></script>
    <script src="~/js/tutorial-tour.js" asp-append-version="true"></script>
    <script src="~/js/records.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required:false)
</body>
</html>




