<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - GET·SET·GO</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chart.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Dashboard" asp-action="Index"><span>GET</span>·SET·GO</a>
        @if(User.Identity?.IsAuthenticated==true)
        {
            <button class="nav-toggle" aria-label="Toggle navigation">☰</button>
            <nav>
                @if(User.IsInRole("Client"))
                {
                    <a asp-controller="Dashboard" asp-action="Index">Overview</a>
                    <a asp-controller="Risk" asp-action="Index">Risk</a>
                    <a asp-controller="Signals" asp-action="Index">GET</a>
                    <a asp-controller="Orders" asp-action="Index">SET / GO / Tracker</a>
                }
                else { <a asp-controller="ResearchAdmin" asp-action="Index">Research desk</a> }
            </nav>
            <div class="user-menu"><span>@User.Identity.Name</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="link-button">Logout</button></form></div>
        }
    </header>
    <main class="shell">
        @if(TempData["Success"] is string success){<div class="alert success">@success</div>}
        @if(TempData["Error"] is string error){<div class="alert error">@error</div>}
        @RenderBody()
    </main>
    <footer>Educational prototype · Simulated orders only · Not investment advice</footer>
    <script src="~/lib/jquery/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/lightweight-charts/lightweight-charts.standalone.production.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required:false)
</body>
</html>
