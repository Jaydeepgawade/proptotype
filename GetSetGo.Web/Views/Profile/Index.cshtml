@model ClientProfileViewModel
@{ ViewData["Title"] = "My profile"; }
<div class="page-head"><div><div class="eyebrow">CLIENT PROFILE</div><h1>@Model.Name</h1><p>@Model.Email</p></div><a class="btn primary" asp-controller="Risk" asp-action="Index">Edit risk setup</a></div>
<section class="metrics"><div class="metric"><span>Total trading money</span><strong>&#8377;@Model.TotalCapital.ToString("N0")</strong><small>Across all trading types</small></div><div class="metric"><span>Active trading types</span><strong>@Model.Profiles.Count(profile => profile.Capital > 0)</strong><small>Styles with allocated money</small></div><div class="metric"><span>SET orders</span><strong>@Model.ActiveOrders.Count(order => order.Status == OrderStatus.Set)</strong><small>Awaiting GO</small></div><div class="metric"><span>Executed orders</span><strong>@Model.ActiveOrders.Count(order => order.Status == OrderStatus.Executed)</strong><small>In tracker</small></div></section>
<section class="card form-card"><div class="eyebrow">YOUR RISK RULES</div><h2>Trading type allocations</h2><div class="profile-style-grid">@foreach(var profile in Model.Profiles.OrderBy(profile => profile.TradingStyle)){<article class="profile-style-card"><span class="style-badge style-@profile.TradingStyle.ToString().ToLowerInvariant()">@profile.TradingStyle</span><strong>&#8377;@profile.Capital.ToString("N0")</strong><small>@profile.RiskPerTradePercent% per trade &middot; @profile.MaxTotalRiskPercent% maximum &middot; @profile.MinimumRewardRiskRatio.ToString("0.0") : 1 R:R</small></article>}</div></section>
<section class="card form-card profile-orders"><div class="page-head"><div><div class="eyebrow">ACTIVE ORDERS</div><h2>SET and executed orders</h2></div><a class="btn secondary" asp-controller="Orders" asp-action="Tracker">Open tracker</a></div>@if(!Model.ActiveOrders.Any()){<p class="muted">You have no active orders.</p>}else{<div class="table-wrap"><table><thead><tr><th>Order</th><th>Stock</th><th>Quantity</th><th>Value</th><th>Status</th></tr></thead><tbody>@foreach(var order in Model.ActiveOrders){<tr><td>#@order.Id</td><td><strong>@order.Symbol</strong></td><td>@order.Quantity</td><td>&#8377;@(order.EntryPrice * order.Quantity).ToString("N2")</td><td><span class="status @order.Status.ToString().ToLowerInvariant()">@order.Status</span></td></tr>}</tbody></table></div>}</section>


