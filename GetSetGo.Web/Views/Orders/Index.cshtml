@model IReadOnlyList<TradeOrder>
@{ViewData["Title"]="Orders and tracker";}
<div class="page-head"><div><div class="eyebrow">SET · GO · TRACKER</div><h1>Your orders</h1><p>Review auto-calculated quantities, execute valid orders and track status.</p></div><a class="btn primary" asp-controller="Signals" asp-action="Index">Get more signals</a></div>
@if(Model.Count==0){<div class="empty card"><h2>No orders yet</h2><p>Choose a matching GET signal and press SET.</p></div>}
else{<div class="table-wrap card"><table><thead><tr><th>Stock</th><th>Setup</th><th>Prices</th><th>Risk</th><th>Validity</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var o in Model){<tr><td><b>@o.Symbol</b><small>@o.Side</small></td><td>@o.Quantity shares<small>₹@((o.EntryPrice*o.Quantity).ToString("N0")) value</small></td><td>₹@o.EntryPrice <small>SL @o.StopLoss · T @o.TargetPrice</small></td><td>₹@o.RiskAmount.ToString("N2")</td><td>@o.ValidUntilUtc.ToLocalTime().ToString("dd MMM")<small>@o.ValidUntilUtc.ToLocalTime().ToString("hh:mm tt")</small></td><td><span class="status @o.Status.ToString().ToLower()">@o.Status</span></td><td>@if(o.Status==OrderStatus.Set){<div class="actions"><form asp-action="Go" method="post" class="api-action" data-api="/api/v1/orders/@o.Id/go" data-confirm="Execute this simulated order now?"><input type="hidden" name="id" value="@o.Id"/><button class="btn go">GO</button></form><form asp-action="Cancel" method="post" class="api-action" data-api="/api/v1/orders/@o.Id/cancel" data-confirm="Cancel this SET order?"><input type="hidden" name="id" value="@o.Id"/><button class="btn text">Cancel</button></form></div>}else{<span class="muted">—</span>}</td></tr>}</tbody></table></div>}
