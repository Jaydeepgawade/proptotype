@model IReadOnlyList<ResearchSignal>
@using System.Globalization
@{ViewData["Title"]="Research desk";}
<div class="page-head"><div><h1>Research desk</h1></div><a class="btn primary" asp-action="Create">+ Generate research signal</a></div>
<section class="record-list card" data-record-list aria-label="Research signals"><div class="record-scroll" tabindex="0" role="region" aria-label="Research signals table">
<table class="record-table"><thead><tr><th>Stock</th><th data-filter="Style">Style</th><th data-filter="Side">Side</th><th class="numeric" data-type="number">Entry</th><th class="numeric" data-type="number">Stop-loss</th><th class="numeric" data-type="number">Target</th><th class="numeric" data-type="number">R:R</th><th data-type="date">Valid until (UTC)</th><th data-filter="Status">Status</th><th data-no-sort>Actions</th></tr></thead><tbody>
@foreach(var s in Model)
{
    var state = !s.IsActive ? "Inactive" : s.ValidUntilUtc < DateTime.UtcNow ? "Expired" : s.ValidFromUtc > DateTime.UtcNow ? "Scheduled" : "Active";
<tr><td><strong>@s.Symbol</strong>@if(s.AiNewsSummary.StartsWith("[AI RESEARCH]", StringComparison.Ordinal)){<small class="ai-source">AI research</small>}</td><td><span class="style-badge style-@s.TradingStyle.ToString().ToLowerInvariant()">@(s.TradingStyle == TradingStyle.ShortTermDelivery ? "Short-term delivery" : s.TradingStyle.ToString())</span></td><td><span class="badge @s.Side.ToString().ToLowerInvariant()">@s.Side</span></td>
<td class="numeric" data-sort="@s.EntryPrice.ToString(CultureInfo.InvariantCulture)">&#8377;@s.EntryPrice.ToString("N2")</td><td class="numeric" data-sort="@s.StopLoss.ToString(CultureInfo.InvariantCulture)">&#8377;@s.StopLoss.ToString("N2")</td><td class="numeric" data-sort="@s.TargetPrice.ToString(CultureInfo.InvariantCulture)">&#8377;@s.TargetPrice.ToString("N2")</td><td class="numeric" data-sort="@s.RewardRiskRatio.ToString(CultureInfo.InvariantCulture)">@Math.Round(s.RewardRiskRatio, MidpointRounding.AwayFromZero).ToString("0") : 1</td><td data-sort="@s.ValidUntilUtc.ToString("yyyy-MM-ddTHH:mm:ss")">@s.ValidUntilUtc.ToString("dd MMM yyyy")<small>@s.ValidUntilUtc.ToString("HH:mm")</small></td><td><span class="status @(state == "Active" ? "executed" : state == "Scheduled" ? "set" : "expired")">@state</span></td><td><div class="signal-admin-actions"><a class="btn secondary" asp-action="Edit" asp-route-id="@s.Id">Edit</a>@if (s.IsActive && state != "Expired"){<form asp-action="Expire" method="post"><input type="hidden" name="id" value="@s.Id"/><button class="btn secondary" type="submit">Expire now</button></form>}@if (s.IsActive){<form asp-action="Deactivate" method="post"><input type="hidden" name="id" value="@s.Id"/><button class="btn text" type="submit">Deactivate</button></form>}</div></td></tr>
}
</tbody></table></div></section>


