@model ResearchSignal
@{ViewData["Title"]="Publish signal";}
<div class="page-head"><div><div class="eyebrow">RESEARCH ADMIN</div><h1>Publish EOD signal</h1><p>Clients will see it only when the style and reward-risk rules match.</p></div></div>
<form method="post" class="card form-card wide"><div asp-validation-summary="All" class="validation"></div>
<div class="field-grid three"><div><label asp-for="Symbol"></label><input asp-for="Symbol" placeholder="RELIANCE"/></div><div><label asp-for="Side"></label><select asp-for="Side" asp-items="Html.GetEnumSelectList<SignalSide>()"></select></div><div><label asp-for="TradingStyle">Style</label><select asp-for="TradingStyle" asp-items="Html.GetEnumSelectList<TradingStyle>()"></select></div></div>
<div class="field-grid three"><div><label asp-for="EntryPrice">Entry</label><input asp-for="EntryPrice" type="number" step="0.05"/></div><div><label asp-for="StopLoss">Stop-loss</label><input asp-for="StopLoss" type="number" step="0.05"/></div><div><label asp-for="TargetPrice">Target</label><input asp-for="TargetPrice" type="number" step="0.05"/></div></div>
<div class="field-grid"><div><label asp-for="ValidFromUtc">Valid from (UTC)</label><input asp-for="ValidFromUtc" type="datetime-local"/></div><div><label asp-for="ValidUntilUtc">Valid until (UTC)</label><input asp-for="ValidUntilUtc" type="datetime-local"/></div></div>
<label asp-for="AiNewsSummary">Simple AI/news brief</label><textarea asp-for="AiNewsSummary" rows="5" placeholder="Explain the recent context in plain language..."></textarea>
<button class="btn primary" type="submit">Publish signal</button> <a class="btn secondary" asp-action="Index">Cancel</a></form>
